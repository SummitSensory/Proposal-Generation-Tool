# Postgres connection string. In Vercel, this is provided automatically when you
# connect a Postgres database (Vercel Postgres, Neon, or Supabase) to the project.
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Random secret used to sign login session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Used to create the first owner login — either via `npm run db:seed` locally, or by visiting
# /api/setup?token=... once after deploying (see README). Change the password immediately
# after first sign-in from Account Settings.
SEED_OWNER_EMAIL="bryanshepherd@summitsensory.com"
SEED_OWNER_PASSWORD="changeme123"

# Any random string. Required to use the one-time /api/setup?token=... URL after deploying,
# so a stranger can't create the first account before you do.
SETUP_TOKEN="make-up-any-random-string-here"

# QuickBooks Online (see README "Connecting QuickBooks Online" for how to get these)
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_REDIRECT_URI="https://your-vercel-domain.vercel.app/api/qbo/callback"
QBO_ENVIRONMENT="sandbox"

# PandaDoc (see README "Connecting PandaDoc")
PANDADOC_API_KEY=""
